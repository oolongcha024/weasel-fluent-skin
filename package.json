{
  "name": "weasel-fluent-skin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @weasel-fluent/preview dev",
    "capture": "pnpm --filter @weasel-fluent/preview capture",
    "check": "pnpm --filter @weasel-fluent/preview check",
    "test": "pnpm --filter @weasel-fluent/preview test",
    "test:browser": "pnpm --filter @weasel-fluent/preview test:browser",
    "build": "pnpm --filter @weasel-fluent/preview build",
    "browser:install": "pnpm --filter @weasel-fluent/preview browser:install",
    "verify:native": "pnpm --filter @weasel-fluent/preview verify:native"
  }
}
